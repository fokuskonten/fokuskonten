# ==============================================================================
# FOKUSKONTEN // OFFICIAL RESCUE INFRASTRUCTURE
# Modul 40: CORELDRAW SHIELD - Anti Blokir Akun & Pop-Up Ilegal
# Metode    : Outbound Windows Firewall Rule & Hosts Null-Routing
# Arsitektur: 100% Native In-Place PowerShell (Single-Terminal Execution)
# ==============================================================================

& {
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 -bor [Net.SecurityProtocolType]::Tls13
    } catch {
        try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}
    }

    $ErrorActionPreference = "Continue"
    $ProgressPreference    = "SilentlyContinue"
    $psv = (Get-Host).Version.Major
    $isISE = $psISE -ne $null

    if ($ExecutionContext.SessionState.LanguageMode.value__ -ne 0) {
        Write-Host "  [!] PowerShell tidak dalam mode FullLanguage. Aborting." -ForegroundColor Red
        return
    }
    try {
        [void][System.AppDomain]::CurrentDomain.GetAssemblies()
        [void][System.Math]::Sqrt(144)
    } catch {
        Write-Host "  [!] Error .NET: $($_.Exception.Message)" -ForegroundColor Red
        return
    }

    $isAdmin = [bool]([Security.Principal.WindowsIdentity]::GetCurrent().Groups -match 'S-1-5-32-544')
    $hostsPath = "$env:SystemRoot\System32\drivers\etc\hosts"
    $corelDomains = @(
        "mc.corel.com",
        "apps.corel.com",
        "origin-mc.corel.com",
        "iws.corel.com",
        "corel.com"
    )

    function Show-Header {
        Clear-Host
        Write-Host ""
        Write-Host "  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~" -ForegroundColor Magenta
        Write-Host "  FOKUSKONTEN // OFFICIAL RESCUE INFRASTRUCTURE" -ForegroundColor Magenta
        Write-Host "  Modul 40 : CORELDRAW SHIELD - Anti Blokir & Pop-Up Ilegal" -ForegroundColor Yellow
        Write-Host "  Metode   : Firewall Outbound Isolation & Null-Route Telemetry" -ForegroundColor White
        Write-Host "  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~" -ForegroundColor Magenta
        Write-Host ""
        Write-Host "  Dokumen desain CDR, palet warna, dan artwork Anda aman 100%." -ForegroundColor Yellow
        Write-Host "  Solusi firewall murni tanpa modifikasi file instalasi biner CorelDRAW." -ForegroundColor Gray
        Write-Host "  -----------------------------------------------------------------" -ForegroundColor DarkGray
        Write-Host "  DETAIL LAYANAN DESAIN CORELDRAW:" -ForegroundColor White
        Write-Host "  * Layanan : CORELDRAW SHIELD - ANTI POP-UP ILEGAL & TELEMETRY" -ForegroundColor Cyan
        Write-Host "  * Sasaran : CorelDRW.exe | Cap.exe | CorelPP.exe | Corel License Service" -ForegroundColor White
        Write-Host "  * Solusi  : Buka kunci tombol Save, Export, Print yang dinonaktifkan" -ForegroundColor Green
        Write-Host "  * Metode  : Outbound Firewall Rule & Hosts Null-Routing (Zero Virus)" -ForegroundColor White
        if ($isAdmin) {
            Write-Host "  * Hak Akses : ADMINISTRATOR RESMI [TERVERIFIKASI]" -ForegroundColor Green
        } else {
            Write-Host "  * Hak Akses : Mode Standar (Akan meminta izin sistem saat menerapkan)" -ForegroundColor Yellow
        }
        Write-Host "  -----------------------------------------------------------------" -ForegroundColor DarkGray
        Write-Host "  MENU TINDAKAN:" -ForegroundColor White
        Write-Host ""
        Write-Host "      [1] Pasang Proteksi Anti Pop-Up CorelDraw (Disarankan)" -ForegroundColor Green
        Write-Host "          Matikan telemetri, blokir notifikasi software bajakan/ilegal." -ForegroundColor Gray
        Write-Host ""
        Write-Host "      [2] Cek Status Proteksi Firewall & Hosts Corel" -ForegroundColor White
        Write-Host "          Memeriksa apakah domain pelacak dan exe Corel sudah terisolasi." -ForegroundColor Gray
        Write-Host ""
        Write-Host "      [3] Pulihkan / Buka Kembali Akses Jaringan Corel (Rollback)" -ForegroundColor Yellow
        Write-Host "          Menghapus aturan blokir firewall dan mengembalikan file hosts." -ForegroundColor Gray
        Write-Host ""
        Write-Host "      [4] Toko Digital FokusKonten - Software & Template Bisnis" -ForegroundColor Cyan
        Write-Host ""
        Write-Host "      [0] Keluar" -ForegroundColor DarkGray
        Write-Host "  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~" -ForegroundColor Magenta
        Write-Host ""
    }

    function Get-UserChoice {
        if ($isISE) {
            $c = Read-Host "  Pilihan Anda [1, 2, 3, 4, 0] (Tekan Enter untuk [1])"
            if ([string]::IsNullOrWhiteSpace($c)) { return "1" }
            return $c.Trim()
        }

        try {
            Write-Host -NoNewline "  Pilihan Anda [1, 2, 3, 4, 0] (Tekan Enter untuk [1]) : " -ForegroundColor Green
            while ($true) {
                $k = [Console]::ReadKey($true)
                if ($k.Key -eq [ConsoleKey]::Enter) {
                    Write-Host "1" -ForegroundColor Green
                    return "1"
                }
                $c = $k.KeyChar.ToString()
                if ($c -in @('1','2','3','4','0')) {
                    Write-Host $c -ForegroundColor Green
                    return $c
                }
            }
        } catch {
            $c = Read-Host "  Pilihan Anda [1, 2, 3, 4, 0] (Tekan Enter untuk [1])"
            if ([string]::IsNullOrWhiteSpace($c)) { return "1" }
            return $c.Trim()
        }
    }

    function Apply-ShieldCore {
        Write-Host ""
        Write-Host "  ================================================================" -ForegroundColor Magenta
        Write-Host "  MEMASANG PROTEKSI FIREWALL & HOSTS CORELDRAW..." -ForegroundColor Yellow
        Write-Host "  ================================================================" -ForegroundColor Magenta
        Write-Host ""

        $script = {
            $hosts = "$env:SystemRoot\System32\drivers\etc\hosts"
            $domains = @("mc.corel.com","apps.corel.com","origin-mc.corel.com","iws.corel.com","corel.com")
            
            # 1. Update Hosts
            if (Test-Path $hosts) {
                $content = Get-Content $hosts -Raw -ErrorAction SilentlyContinue
                $newEntries = @()
                foreach ($d in $domains) {
                    if ($content -notmatch [regex]::Escape($d)) {
                        $newEntries += "0.0.0.0 $d"
                        $newEntries += "127.0.0.1 $d"
                    }
                }
                if ($newEntries.Count -gt 0) {
                    Add-Content -Path $hosts -Value ("`r`n# FokusKonten Corel Shield`r`n" + ($newEntries -join "`r`n")) -ErrorAction SilentlyContinue
                }
            }

            # 2. Add Firewall Rules
            $paths = @(
                "C:\Program Files\Corel\*\Programs64\CorelDRW.exe",
                "C:\Program Files\Corel\*\Programs64\Cap.exe",
                "C:\Program Files\Corel\*\Programs64\CorelPP.exe",
                "C:\Program Files (x86)\Corel\*\Programs\CorelDRW.exe"
            )
            $found = @()
            foreach ($p in $paths) {
                $resolved = Resolve-Path $p -ErrorAction SilentlyContinue
                if ($resolved) { $found += $resolved.Path }
            }

            Remove-NetFirewallRule -DisplayName "FK_Corel_*" -ErrorAction SilentlyContinue
            $idx = 1
            foreach ($exe in $found) {
                New-NetFirewallRule -DisplayName "FK_Corel_Outbound_Block_$idx" `
                    -Direction Outbound -Program $exe -Action Block `
                    -Description "FokusKonten Anti Pop-Up CorelDraw Isolation" -ErrorAction SilentlyContinue | Out-Null
                $idx++
            }
        }

        if ($isAdmin) {
            & $script
            Write-Host "  [OK] Aturan Firewall & entri Hosts CorelDraw berhasil dipasang in-place!" -ForegroundColor Green
        } else {
            Write-Host "  -> Meminta izin Administrator sistem (UAC)..." -ForegroundColor Yellow
            $b64 = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($script.ToString()))
            $p = Start-Process powershell -ArgumentList "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand $b64" -Verb RunAs -Wait -PassThru
            if ($p.ExitCode -eq 0) {
                Write-Host "  [OK] Aturan Firewall & entri Hosts CorelDraw berhasil diterapkan!" -ForegroundColor Green
            } else {
                Write-Host "  [!] Izin Administrator ditolak atau gagal menerapkan proteksi." -ForegroundColor Red
            }
        }
        Write-Host "  Pemberitahuan software ilegal dan pemblokiran akun berhasil dicegah." -ForegroundColor Gray
    }

    function Check-ShieldStatus {
        Write-Host ""
        Write-Host "  ================================================================" -ForegroundColor Magenta
        Write-Host "  STATUS PROTEKSI CORELDRAW SAAT INI" -ForegroundColor Yellow
        Write-Host "  ================================================================" -ForegroundColor Magenta
        Write-Host ""
        
        Write-Host "  [+] Status File Hosts ($hostsPath):" -ForegroundColor Cyan
        $content = if (Test-Path $hostsPath) { Get-Content $hostsPath -Raw -ErrorAction SilentlyContinue } else { "" }
        foreach ($d in $corelDomains) {
            if ($content -match [regex]::Escape($d)) {
                Write-Host "      [TERLINDUNGI] $d -> Null-Routed (0.0.0.0 / 127.0.0.1)" -ForegroundColor Green
            } else {
                Write-Host "      [TERBUKA]     $d -> Belum diblokir" -ForegroundColor DarkGray
            }
        }

        Write-Host ""
        Write-Host "  [+] Status Aturan Windows Firewall:" -ForegroundColor Cyan
        $fwRules = Get-NetFirewallRule -DisplayName "FK_Corel_*" -ErrorAction SilentlyContinue
        if ($fwRules) {
            foreach ($r in $fwRules) {
                Write-Host "      [TERPASANG] $($r.DisplayName) : $($r.Action) $($r.Direction)" -ForegroundColor Green
            }
        } else {
            Write-Host "      [TIDAK ADA] Aturan firewall FokusKonten belum aktif." -ForegroundColor Yellow
        }
    }

    function Rollback-Shield {
        Write-Host ""
        Write-Host "  ================================================================" -ForegroundColor Yellow
        Write-Host "  MEMULIHKAN / MENCABUT PROTEKSI CORELDRAW..." -ForegroundColor Yellow
        Write-Host "  ================================================================" -ForegroundColor Yellow
        Write-Host ""

        $script = {
            $hosts = "$env:SystemRoot\System32\drivers\etc\hosts"
            $domains = @("mc.corel.com","apps.corel.com","origin-mc.corel.com","iws.corel.com","corel.com")
            
            if (Test-Path $hosts) {
                $lines = Get-Content $hosts -ErrorAction SilentlyContinue
                $clean = $lines | Where-Object {
                    $l = $_
                    $keep = $true
                    if ($l -match "# FokusKonten Corel Shield") { $keep = $false }
                    foreach ($d in $domains) {
                        if ($l -match [regex]::Escape($d)) { $keep = $false }
                    }
                    $keep
                }
                [System.IO.File]::WriteAllLines($hosts, $clean, [System.Text.Encoding]::ASCII)
            }

            Remove-NetFirewallRule -DisplayName "FK_Corel_*" -ErrorAction SilentlyContinue
        }

        if ($isAdmin) {
            & $script
            Write-Host "  [OK] Aturan Firewall dicabut dan File Hosts dipulihkan ke semula!" -ForegroundColor Green
        } else {
            Write-Host "  -> Meminta izin Administrator sistem (UAC)..." -ForegroundColor Yellow
            $b64 = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($script.ToString()))
            $p = Start-Process powershell -ArgumentList "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand $b64" -Verb RunAs -Wait -PassThru
            if ($p.ExitCode -eq 0) {
                Write-Host "  [OK] Aturan Firewall dicabut dan File Hosts dipulihkan ke semula!" -ForegroundColor Green
            } else {
                Write-Host "  [!] Izin Administrator ditolak atau gagal memulihkan." -ForegroundColor Red
            }
        }
    }

    # Main Loop
    Show-Header
    $choice = Get-UserChoice

    switch ($choice) {
        "1" { Apply-ShieldCore }
        "2" { Check-ShieldStatus }
        "3" { Rollback-Shield }
        "4" {
            Start-Process "https://fokuskonten.my.id/toko-digital/"
            Write-Host "  Membuka etalase digital FokusKonten di peramban web..." -ForegroundColor Cyan
        }
        default {
            Write-Host ""
            Write-Host "  Operasi selesai / dibatalkan. Terima kasih." -ForegroundColor Yellow
            exit 0
        }
    }

    Write-Host ""
    Write-Host "  Tekan sembarang tombol untuk menutup sesi..." -ForegroundColor DarkGray
    try { [Console]::ReadKey($true) | Out-Null } catch {}
} @args
