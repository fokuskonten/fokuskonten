# ==============================================================================
# FOKUSKONTEN // OFFICIAL RESCUE INFRASTRUCTURE
# Modul 39: ADOBE SHIELD - Anti Pop-Up Unlicensed & AGSService Blocker
# Metode    : Outbound Windows Firewall Rule & Hosts Null-Routing & AGS Killer
# Arsitektur: 100% Native In-Place PowerShell (Single-Terminal Execution)
# ==============================================================================

& {
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 -bor [Net.SecurityProtocolType]::Tls13
    } catch {
        try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}
    }

    $ErrorActionPreference = "Continue"
    $ProgressPreference    = "SilentlyContinue"
    $psv = (Get-Host).Version.Major
    $isISE = $psISE -ne $null

    if ($ExecutionContext.SessionState.LanguageMode.value__ -ne 0) {
        Write-Host "  [!] PowerShell tidak dalam mode FullLanguage. Aborting." -ForegroundColor Red
        return
    }
    try {
        [void][System.AppDomain]::CurrentDomain.GetAssemblies()
        [void][System.Math]::Sqrt(144)
    } catch {
        Write-Host "  [!] Error .NET: $($_.Exception.Message)" -ForegroundColor Red
        return
    }

    $isAdmin = [bool]([Security.Principal.WindowsIdentity]::GetCurrent().Groups -match 'S-1-5-32-544')
    $hostsPath = "$env:SystemRoot\System32\drivers\etc\hosts"
    $adobeDomains = @(
        "lmlicenses.wip4.adobe.com",
        "lm.licenses.adobe.com",
        "na1r.services.adobe.com",
        "hlrcv.stage.adobe.com",
        "genuine.adobe.com",
        "cc-api-data.adobe.com",
        "adobeid-na1.services.adobe.com"
    )

    function Show-Header {
        Clear-Host
        Write-Host ""
        Write-Host "  /////////////////////////////////////////////////////////////////" -ForegroundColor Red
        Write-Host "  FOKUSKONTEN // OFFICIAL RESCUE INFRASTRUCTURE" -ForegroundColor Red
        Write-Host "  Modul 39 : ADOBE SHIELD - Anti Pop-Up 'This Unlicensed App'" -ForegroundColor Yellow
        Write-Host "  Metode   : Firewall Outbound Isolation & AGS Service Killer" -ForegroundColor White
        Write-Host "  /////////////////////////////////////////////////////////////////" -ForegroundColor Red
        Write-Host ""
        Write-Host "  Proyek kreatif Photoshop, Illustrator, Premiere, dan After Effects aman." -ForegroundColor Yellow
        Write-Host "  Solusi firewall murni tanpa modifikasi file instalasi biner Adobe." -ForegroundColor Gray
        Write-Host "  -----------------------------------------------------------------" -ForegroundColor DarkGray
        Write-Host "  DETAIL LAYANAN ADOBE CREATIVE CLOUD:" -ForegroundColor White
        Write-Host "  * Layanan : ADOBE SHIELD - ANTI POP-UP UNLICENSED & AGSSERVICE" -ForegroundColor Cyan
        Write-Host "  * Sasaran : Photoshop | Illustrator | Premiere | After Effects | InDesign" -ForegroundColor White
        Write-Host "  * Solusi  : Matikan pop-up countdown 10 hari & nonaktifkan AGSService" -ForegroundColor Green
        Write-Host "  * Metode  : Outbound Firewall Rule & Hosts Null-Routing (Zero Virus)" -ForegroundColor White
        if ($isAdmin) {
            Write-Host "  * Hak Akses : ADMINISTRATOR RESMI [TERVERIFIKASI]" -ForegroundColor Green
        } else {
            Write-Host "  * Hak Akses : Mode Standar (Akan meminta izin sistem saat menerapkan)" -ForegroundColor Yellow
        }
        Write-Host "  -----------------------------------------------------------------" -ForegroundColor DarkGray
        Write-Host "  MENU TINDAKAN:" -ForegroundColor White
        Write-Host ""
        Write-Host "      [1] Pasang Proteksi Anti Pop-Up Adobe (Disarankan)" -ForegroundColor Green
        Write-Host "          Matikan AGSService, blokir telemetri genuine.adobe.com." -ForegroundColor Gray
        Write-Host ""
        Write-Host "      [2] Cek Status Proteksi Firewall, Hosts, & AGSService" -ForegroundColor White
        Write-Host "          Memeriksa kesehatan isolasi seluruh aplikasi Adobe." -ForegroundColor Gray
        Write-Host ""
        Write-Host "      [3] Pulihkan / Buka Kembali Akses Jaringan Adobe (Rollback)" -ForegroundColor Yellow
        Write-Host "          Menghapus aturan blokir firewall dan mengembalikan file hosts." -ForegroundColor Gray
        Write-Host ""
        Write-Host "      [4] Toko Digital FokusKonten - Software & Template Bisnis" -ForegroundColor Cyan
        Write-Host ""
        Write-Host "      [0] Keluar" -ForegroundColor DarkGray
        Write-Host "  /////////////////////////////////////////////////////////////////" -ForegroundColor Red
        Write-Host ""
    }

    function Get-UserChoice {
        if ($isISE) {
            $c = Read-Host "  Pilihan Anda [1, 2, 3, 4, 0] (Tekan Enter untuk [1])"
            if ([string]::IsNullOrWhiteSpace($c)) { return "1" }
            return $c.Trim()
        }

        try {
            Write-Host -NoNewline "  Pilihan Anda [1, 2, 3, 4, 0] (Tekan Enter untuk [1]) : " -ForegroundColor Green
            while ($true) {
                $k = [Console]::ReadKey($true)
                if ($k.Key -eq [ConsoleKey]::Enter) {
                    Write-Host "1" -ForegroundColor Green
                    return "1"
                }
                $c = $k.KeyChar.ToString()
                if ($c -in @('1','2','3','4','0')) {
                    Write-Host $c -ForegroundColor Green
                    return $c
                }
            }
        } catch {
            $c = Read-Host "  Pilihan Anda [1, 2, 3, 4, 0] (Tekan Enter untuk [1])"
            if ([string]::IsNullOrWhiteSpace($c)) { return "1" }
            return $c.Trim()
        }
    }

    function Apply-ShieldAdobe {
        Write-Host ""
        Write-Host "  ================================================================" -ForegroundColor Red
        Write-Host "  MEMASANG PROTEKSI FIREWALL, HOSTS, & AGSSERVICE ADOBE..." -ForegroundColor Yellow
        Write-Host "  ================================================================" -ForegroundColor Red
        Write-Host ""

        $script = {
            $hosts = "$env:SystemRoot\System32\drivers\etc\hosts"
            $domains = @(
                "lmlicenses.wip4.adobe.com",
                "lm.licenses.adobe.com",
                "na1r.services.adobe.com",
                "hlrcv.stage.adobe.com",
                "genuine.adobe.com",
                "cc-api-data.adobe.com",
                "adobeid-na1.services.adobe.com"
            )
            
            # 1. Update Hosts
            if (Test-Path $hosts) {
                $content = Get-Content $hosts -Raw -ErrorAction SilentlyContinue
                $newEntries = @()
                foreach ($d in $domains) {
                    if ($content -notmatch [regex]::Escape($d)) {
                        $newEntries += "0.0.0.0 $d"
                        $newEntries += "127.0.0.1 $d"
                    }
                }
                if ($newEntries.Count -gt 0) {
                    Add-Content -Path $hosts -Value ("`r`n# FokusKonten Adobe Shield`r`n" + ($newEntries -join "`r`n")) -ErrorAction SilentlyContinue
                }
            }

            # 2. Disable AGSService
            try {
                Stop-Service -Name "AGSService" -Force -ErrorAction SilentlyContinue
                Set-Service -Name "AGSService" -StartupType Disabled -ErrorAction SilentlyContinue
            } catch {}

            # 3. Add Firewall Rules for Adobe Exe
            $paths = @(
                "C:\Program Files\Adobe\*\Photoshop.exe",
                "C:\Program Files\Adobe\*\Illustrator.exe",
                "C:\Program Files\Adobe\*\Adobe Premiere Pro.exe",
                "C:\Program Files\Adobe\*\AfterFX.exe",
                "C:\Program Files\Adobe\*\InDesign.exe",
                "C:\Program Files (x86)\Common Files\Adobe\Adobe Desktop Common\*\*.exe"
            )
            $found = @()
            foreach ($p in $paths) {
                $resolved = Resolve-Path $p -ErrorAction SilentlyContinue
                if ($resolved) { $found += $resolved.Path }
            }

            Remove-NetFirewallRule -DisplayName "FK_Adobe_*" -ErrorAction SilentlyContinue
            $idx = 1
            foreach ($exe in $found) {
                New-NetFirewallRule -DisplayName "FK_Adobe_Outbound_Block_$idx" `
                    -Direction Outbound -Program $exe -Action Block `
                    -Description "FokusKonten Anti Pop-Up Adobe Isolation" -ErrorAction SilentlyContinue | Out-Null
                $idx++
            }
        }

        if ($isAdmin) {
            & $script
            Write-Host "  [OK] Aturan Firewall & entri Hosts Adobe berhasil dipasang in-place!" -ForegroundColor Green
        } else {
            Write-Host "  -> Meminta izin Administrator sistem (UAC)..." -ForegroundColor Yellow
            $b64 = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($script.ToString()))
            $p = Start-Process powershell -ArgumentList "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand $b64" -Verb RunAs -Wait -PassThru
            if ($p.ExitCode -eq 0) {
                Write-Host "  [OK] Aturan Firewall, entri Hosts, & AGSService berhasil dinonaktifkan!" -ForegroundColor Green
            } else {
                Write-Host "  [!] Izin Administrator ditolak atau gagal menerapkan proteksi." -ForegroundColor Red
            }
        }
        Write-Host "  Pop-up 'This unlicensed app will be disabled soon' berhasil dicegah." -ForegroundColor Gray
    }

    function Check-AdobeStatus {
        Write-Host ""
        Write-Host "  ================================================================" -ForegroundColor Red
        Write-Host "  STATUS PROTEKSI ADOBE SAAT INI" -ForegroundColor Yellow
        Write-Host "  ================================================================" -ForegroundColor Red
        Write-Host ""
        
        Write-Host "  [+] Status File Hosts ($hostsPath):" -ForegroundColor Cyan
        $content = if (Test-Path $hostsPath) { Get-Content $hostsPath -Raw -ErrorAction SilentlyContinue } else { "" }
        foreach ($d in $adobeDomains) {
            if ($content -match [regex]::Escape($d)) {
                Write-Host "      [TERLINDUNGI] $d -> Null-Routed (0.0.0.0 / 127.0.0.1)" -ForegroundColor Green
            } else {
                Write-Host "      [TERBUKA]     $d -> Belum diblokir" -ForegroundColor DarkGray
            }
        }

        Write-Host ""
        Write-Host "  [+] Status Layanan AGSService (Adobe Genuine Service):" -ForegroundColor Cyan
        $ags = Get-Service -Name "AGSService" -ErrorAction SilentlyContinue
        if ($ags) {
            Write-Host "      Status: $($ags.Status) | Startup: $($ags.StartType)" -ForegroundColor $(if ($ags.Status -eq 'Running') { 'Red' } else { 'Green' })
        } else {
            Write-Host "      AGSService tidak terdeteksi pada sistem ini (Aman)." -ForegroundColor Green
        }

        Write-Host ""
        Write-Host "  [+] Status Aturan Windows Firewall:" -ForegroundColor Cyan
        $fwRules = Get-NetFirewallRule -DisplayName "FK_Adobe_*" -ErrorAction SilentlyContinue
        if ($fwRules) {
            foreach ($r in $fwRules) {
                Write-Host "      [TERPASANG] $($r.DisplayName) : $($r.Action) $($r.Direction)" -ForegroundColor Green
            }
        } else {
            Write-Host "      [TIDAK ADA] Aturan firewall FokusKonten belum aktif." -ForegroundColor Yellow
        }
    }

    function Rollback-Adobe {
        Write-Host ""
        Write-Host "  ================================================================" -ForegroundColor Yellow
        Write-Host "  MEMULIHKAN / MENCABUT PROTEKSI ADOBE..." -ForegroundColor Yellow
        Write-Host "  ================================================================" -ForegroundColor Yellow
        Write-Host ""

        $script = {
            $hosts = "$env:SystemRoot\System32\drivers\etc\hosts"
            $domains = @(
                "lmlicenses.wip4.adobe.com",
                "lm.licenses.adobe.com",
                "na1r.services.adobe.com",
                "hlrcv.stage.adobe.com",
                "genuine.adobe.com",
                "cc-api-data.adobe.com",
                "adobeid-na1.services.adobe.com"
            )
            
            if (Test-Path $hosts) {
                $lines = Get-Content $hosts -ErrorAction SilentlyContinue
                $clean = $lines | Where-Object {
                    $l = $_
                    $keep = $true
                    if ($l -match "# FokusKonten Adobe Shield") { $keep = $false }
                    foreach ($d in $domains) {
                        if ($l -match [regex]::Escape($d)) { $keep = $false }
                    }
                    $keep
                }
                [System.IO.File]::WriteAllLines($hosts, $clean, [System.Text.Encoding]::ASCII)
            }

            Remove-NetFirewallRule -DisplayName "FK_Adobe_*" -ErrorAction SilentlyContinue

            try {
                Set-Service -Name "AGSService" -StartupType Manual -ErrorAction SilentlyContinue
            } catch {}
        }

        if ($isAdmin) {
            & $script
            Write-Host "  [OK] Aturan Firewall dicabut dan File Hosts dipulihkan ke semula!" -ForegroundColor Green
        } else {
            Write-Host "  -> Meminta izin Administrator sistem (UAC)..." -ForegroundColor Yellow
            $b64 = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($script.ToString()))
            $p = Start-Process powershell -ArgumentList "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand $b64" -Verb RunAs -Wait -PassThru
            if ($p.ExitCode -eq 0) {
                Write-Host "  [OK] Aturan Firewall dicabut dan File Hosts dipulihkan ke semula!" -ForegroundColor Green
            } else {
                Write-Host "  [!] Izin Administrator ditolak atau gagal memulihkan." -ForegroundColor Red
            }
        }
    }

    # Main Loop
    Show-Header
    $choice = Get-UserChoice

    switch ($choice) {
        "1" { Apply-ShieldAdobe }
        "2" { Check-AdobeStatus }
        "3" { Rollback-Adobe }
        "4" {
            Start-Process "https://fokuskonten.my.id/toko-digital/"
            Write-Host "  Membuka etalase digital FokusKonten di peramban web..." -ForegroundColor Cyan
        }
        default {
            Write-Host ""
            Write-Host "  Operasi selesai / dibatalkan. Terima kasih." -ForegroundColor Yellow
            exit 0
        }
    }

    Write-Host ""
    Write-Host "  Tekan sembarang tombol untuk menutup sesi..." -ForegroundColor DarkGray
    try { [Console]::ReadKey($true) | Out-Null } catch {}
} @args
